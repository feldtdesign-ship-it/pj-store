e\u003cspan\u003eCrafted from an 80% acrylic \/ 20% wool blend, the hat holds its shape while staying lightweight \u0026amp; comfortable. Finished with a classic dad-hat fit \u0026amp; adjustable strap, it’s equal parts innocent \u0026amp; iconic: where refinement meets irony.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan\u003eExtra excellence in every package.\u003c\/span\u003e\u003c\/p\u003e","published_at":"2023-10-23T12:19:27-04:00","created_at":"2023-10-23T12:19:27-04:00","updated_at":"2026-10-24T07:29:21-04:00","vendor":"PJ O'Rourke","product_type":"","tags":["Hat","Selfies At Tiffany's Hat"],"variants":[{"id":47994584203495,"title":"One Size \/ White","option1":"One Size","option2":"White","option3":null,"sku":"","requires_shipping":true,"taxable":true,"featured_image":{"id":48904123580647,"product_id":8517057872103,"position":1,"created_at":"2026-01-19T14:10:29-05:00","updated_at":"2026-01-19T14:10:48-05:00","alt":null,"width":1024,"height":1024,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0579\/8045\/3021\/files\/IMG-7938.png?v=1768849848","variant_ids":[47994584203495]},"available":true,"price":"55.00","grams":0,"compare_at_price":null,"position":1,"product_id":8517057872103,"created_at":"2023-10-23T12:19:28-04:00","updated_at":"2026-10-24T07:29:21-04:00"},{"id":51718345195751,"title":"One Size \/ Black","option1":"One Size","option2":"Black","option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":{"id":48869234671847,"product_id":8517057872103,"position":3,"created_at":"2026-01-13T11:18:50-05:00","updated_at":"2026-01-19T14:10:48-05:00","alt":null,"width":1330,"height":1308,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0579\/8045\/3021\/files\/black-dad-hat-selfies-at-tiffanys.webp?v=1768849848","variant_ids":[51718345195751]},"available":true,"price":"55.00","grams":0,"compare_at_price":null,"position":2,"product_id":8517057872103,"created_at":"2026-01-14T13:21:34-05:00","updated_at":"2026-10-24T07:29:21-04:00"}]